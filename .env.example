# Copy this file to .env and fill in the values before running `npm run setup`.

# PostgreSQL connection string for the ERP database.
# Windows example (local install, default port):
#   postgresql://postgres:YOUR_PASSWORD@localhost:5432/moltenmetalerp
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/moltenmetalerp"

# Signs the session cookie. Must be long and random, and must differ between
# installations - anyone who knows it can mint a valid login for any user.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="change-this-to-a-long-random-string"

NODE_ENV="production"

# ---------------------------------------------------------------------------
# Optional. Read only by `npm run setup`, and only when the account does not
# exist yet - re-running setup never changes an existing password.
#
# Leave a _PASSWORD unset and setup generates a strong one and prints it once.
# Set them here to choose your own. Delete this whole block afterwards; it has
# no effect once the accounts exist, and passwords do not belong in a file.
# ---------------------------------------------------------------------------

# Full access, including users and settings
# ADMIN_EMAIL="admin@yourfoundry.com"
# ADMIN_NAME="Plant Administrator"
# ADMIN_PASSWORD=""

# Production, parts, purchase orders, suppliers, companies
# PRODUCTION_EMAIL="production@yourfoundry.com"
# PRODUCTION_NAME="Production Manager"
# PRODUCTION_PASSWORD=""

# Fettling shop, employees, inventory, production
# FETTLING_EMAIL="fettling@yourfoundry.com"
# FETTLING_NAME="Fettling Manager"
# FETTLING_PASSWORD=""

# Read-only across operations; owns users and settings
# ACCOUNTS_EMAIL="accounts@yourfoundry.com"
# ACCOUNTS_NAME="Accounts"
# ACCOUNTS_PASSWORD=""
